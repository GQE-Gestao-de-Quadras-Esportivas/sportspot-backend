# Copie para .env e ajuste. Todos os valores abaixo são fictícios.
HOST=127.0.0.1
PORT=3000

# Postgres local
DB_URL=postgres://postgres:postgres@127.0.0.1:5432/sportspot
# Use true apenas para bancos hospedados que exigem SSL (ex.: Render)
DB_SSL=false
DB_LOGGING=false

JWT_SECRET=troque-este-segredo-de-exemplo
JWT_REFRESH_SECRET=troque-este-outro-segredo-de-exemplo

# Origem do frontend Angular (CORS)
CORS_ORIGIN=http://localhost:4200
