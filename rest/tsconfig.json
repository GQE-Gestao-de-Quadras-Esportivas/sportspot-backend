{
   "compilerOptions": {
      "lib": [
         "es2023"
      ],
      "target": "es2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "strict": true,
      "esModuleInterop": true,
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "skipLibCheck": true,
      "typeRoots": ["./node_modules/@types", "./src/@types"]
   },
   "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}